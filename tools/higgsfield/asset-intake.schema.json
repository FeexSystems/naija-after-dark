{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FeexSystems/naija-after-dark/blob/main/tools/higgsfield/asset-intake.schema.json",
  "title": "NAAD Higgsfield Asset Intake Manifest",
  "type": "object",
  "required": ["schema_version", "project", "repository", "pilot", "assets"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "project": { "const": "NAIJA AFTER DARK" },
    "repository": { "const": "FeexSystems/naija-after-dark" },
    "pilot": { "type": "string", "minLength": 1 },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "asset_name", "category", "district", "target_scene", "status"],
        "properties": {
          "asset_id": { "type": "string", "pattern": "^NAAD-[A-Z]{3}-[0-9]{3}$" },
          "asset_name": { "type": "string", "pattern": "^[A-Z]{3}_[A-Za-z0-9]+_[A-Z]{2}_v[0-9]{3}$" },
          "category": { "enum": ["APT", "CHR", "INT", "NCL", "PRP", "STR", "SYU", "BCH", "VHC"] },
          "district": { "enum": ["ND", "ML", "IS", "CR", "CS"] },
          "venue": { "enum": ["APT", "SYU", "STR", "NCL", "BCH"] },
          "target_scene": { "enum": ["Bootstrap", "Apartment", "CityStreet", "SuyaSpot", "Nightclub", "Beach"] },
          "status": { "enum": ["planned", "generated", "staged", "validated", "approved_for_unity", "rejected"] },
          "provider": { "type": "string" },
          "generation_job_id": { "type": "string" },
          "brief": { "type": "string" },
          "source_format": { "enum": ["glb", "fbx", "blend", "png", "jpg", "jpeg", "wav", "mp3", "mp4"] },
          "staged_file": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "license_status": { "enum": ["unknown", "pending_review", "cleared", "restricted"] },
          "license_evidence": { "type": "string" },
          "polygon_count": { "type": "integer", "minimum": 0 },
          "validation_notes": { "type": "string" },
          "approved_by": { "type": "string" },
          "approved_at": { "type": "string", "format": "date-time" },
          "brief_ref": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
