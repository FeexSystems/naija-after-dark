{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naad.game/schemas/world-state.schema.json",
  "title": "WorldState",
  "description": "Singleton simulation clock and ambient conditions. Server owns time.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "gameTime", "weather", "trafficLevel", "nightlifeLevel", "timeScale"],
  "properties": {
    "id": { "type": "integer", "const": 1 },
    "gameTime": {
      "type": "string",
      "format": "date-time",
      "description": "Authoritative in-game timestamp (not device clock)."
    },
    "weather": {
      "type": "string",
      "enum": ["CLEAR", "CLOUDY", "RAIN", "HEAVY_RAIN", "HARMATTAN"]
    },
    "trafficLevel": { "type": "integer", "minimum": 0, "maximum": 100 },
    "nightlifeLevel": { "type": "integer", "minimum": 0, "maximum": 100 },
    "timeScale": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000,
      "description": "Simulated minutes per real minute."
    },
    "period": {
      "type": "string",
      "enum": ["MORNING", "DAY", "TRANSITION", "NIGHT", "LATE_NIGHT", "AFTER_HOURS"]
    },
    "minutesSinceMidnight": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1439
    }
  }
}
